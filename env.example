# Lead Entry Guard environment example
# Copy this file to .env and fill in values as needed.
# Do not commit real secrets.

# App
LEG_ENVIRONMENT=development
LEG_DEBUG=true

# Database (Phase 3A tenant store)
LEG_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# Redis
LEG_REDIS_URL=redis://localhost:6379/0
LEG_REDIS_CONNECT_TIMEOUT=2.0
LEG_REDIS_SOCKET_TIMEOUT=1.0
LEG_REDIS_MAX_CONNECTIONS=50

# Duplicate and idempotency TTLs
LEG_DUPLICATE_TTL_SECONDS=2592000
LEG_IDEMPOTENCY_TTL_SECONDS=86400

# Vault / key management
LEG_VAULT_BACKEND=hashicorp
LEG_VAULT_URL=http://localhost:8200
LEG_VAULT_TOKEN=your-dev-token
LEG_VAULT_SECRET_PATH=secret/lead-entry-guard/hmac-keys
LEG_KEY_POLL_INTERVAL_SECONDS=60
LEG_KEY_CONFIRMATION_TIMEOUT_SECONDS=300

# Bloom filter
LEG_BLOOM_DEFAULT_CAPACITY=2000000
LEG_BLOOM_TARGET_FPR=0.001
LEG_BLOOM_FILL_RATIO_ALERT_THRESHOLD=0.70
LEG_BLOOM_FPR_ALERT_THRESHOLD=0.01

# Policy / config versioning
LEG_POLICY_VERSION=v1.0.0
LEG_RULESET_VERSION=v1.0.0
LEG_CONFIG_VERSION=v1.0.0
LEG_CONFIG_MISMATCH_GRACE_PERIOD_SECONDS=60

# Shadow mode
LEG_SHADOW_QUEUE_MAX_SIZE=10000
LEG_SHADOW_CPU_BUDGET_PCT=0.20
LEG_SHADOW_SAMPLE_RATE_LOW_TRAFFIC=1.0
LEG_SHADOW_SAMPLE_RATE_HIGH_TRAFFIC=0.10
LEG_SHADOW_TRAFFIC_THRESHOLD_RPS=1000
LEG_SHADOW_MIN_SAMPLE_SIZE=1000
LEG_SHADOW_MAX_DURATION_DAYS=30
LEG_SHADOW_AUTO_ESCALATE_DAYS=14

# Queue degraded mode
LEG_QUEUE_HARD_CAP_PER_TENANT=500
LEG_QUEUE_HOLD_TIMEOUT_SECONDS=900

# Reconciliation
LEG_RECONCILIATION_PER_TENANT_RATE_LIMIT=1000
LEG_RECONCILIATION_GLOBAL_RATE_LIMIT=10000
LEG_RECONCILIATION_RETRY_MAX_AGE_HOURS=24

# Telemetry / StatsD
LEG_TELEMETRY_QUEUE_MAX_SIZE=50000
LEG_TELEMETRY_QUEUE_WARN_THRESHOLD=0.80
LEG_STATSD_HOST=localhost
LEG_STATSD_PORT=8125
LEG_HEARTBEAT_INTERVAL_SECONDS=60